# Copy to .env.local and adjust ports if needed. Vite only exposes vars
# prefixed with VITE_ to client code.
#
# Two separate backends are involved now: BreathQuest (login/patients — see
# lib/breathquestApi.js) and VaakMirror's own (game data/dashboard — see
# lib/api.js). If both run locally at once, they can't both sit on 8000 —
# run one of them on a different port and update the matching URL below.
VITE_BREATHQUEST_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8010
