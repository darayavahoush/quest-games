# Copy this to .env and adjust.
#
# Points at BreathQuest's actual database now, not a separate one — that's
# the whole point of the integration. Use the same postgres user/db
# BreathQuest itself uses (check BreathQuest's own .env for its exact
# values if you've changed them from the default).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/breathquest

# MUST be the exact same value as SECRET_KEY in BreathQuest's own .env —
# this is what makes "log into BreathQuest, use that token in VaakMirror"
# work. If these two values ever drift apart, every token verification
# here will fail with 401s that look like nothing is wrong on either side
# individually.
SECRET_KEY=change-this-to-a-real-secret-run-openssl-rand-hex-32
ALGORITHM=HS256
